private lemma cauchyMediumDefault_spec :
    ∀ q : Fin 109,
      q.1 ≠ 0 →
        let (b, t, u, v, w) := cauchyMediumDefault q
        cauchyTriPredSum4 t u v w = q.1 ∧
        cauchyBSum4 t u v w = b ∧
        1 ≤ b ∧ b ≤ 22 := by
  native_decide

private lemma cauchyMediumSpecial_spec :
    ∀ q : Fin 109,
      q.1 ≠ 0 →
        ∀ rem : Fin 22,
          let (mode, b, t, u, v, w) := cauchyMediumSpecial q rem
          let (b0, _, _, _, _) := cauchyMediumDefault q
          rem.1 < b0 →
            ((mode = false ∧
                cauchyTriPredSum4 t u v w = q.1 ∧
                cauchyBSum4 t u v w = b ∧
                1 ≤ b ∧ b ≤ rem.1)
              ∨
              (mode = true ∧
                cauchyTriPredSum4 t u v w = q.1 - 1 ∧
                cauchyBSum4 t u v w = b ∧
                rem.1 + 2 ≤ b ∧ b ≤ rem.1 + 22)) := by
  native_decide

/-!
## Exported lemma

We keep the lookup tables `private` (they are large, generated, and not intended as API), and expose
only the derived decomposition lemma needed by `GeometryOfNumbers.Cauchy.Main`.
-/

/-- Medium-regime decomposition in the subcase `m := s-2 ≥ 22`.

This discharges the bounded band `n ≤ 108*(s-2)` without using the Cauchy/Nathanson window
inequalities (which are not uniform in the bounded regime). -/
lemma cauchy_decomposition_medium_mge22
    (s : ℕ) (hs : 5 ≤ s) (n : ℕ) (_hn_pos : 0 < n)
    (hsmall : ¬ n ≤ s - 3) (hmed : n ≤ 108 * (s - 2)) (hm22 : 22 ≤ s - 2) :
    ∃ t u v w r : ℕ,
      r ≤ s - 4 ∧ polygonal s t + polygonal s u + polygonal s v + polygonal s w + r = n := by
  classical
  let m : ℕ := s - 2
  have hm_pos : 0 < m := by
    have : (3 : ℕ) ≤ m := by
      -- `5 ≤ s` ⇒ `3 ≤ s-2`.
      simpa [m] using Nat.sub_le_sub_right hs 2
    omega
  have hm_le_n : m ≤ n := by
    -- `¬ n ≤ s-3` ⇒ `s-2 ≤ n` (hence `m ≤ n`).
    have : s - 2 ≤ n := by omega
    simpa [m] using this

  let qNat : ℕ := n / m
  let remNat : ℕ := n % m
  have hn_decomp : m * qNat + remNat = n := by
    simpa [qNat, remNat] using (Nat.div_add_mod n m)

  have hq_pos : qNat ≠ 0 := by
    have : 0 < qNat := Nat.div_pos hm_le_n hm_pos
    exact Nat.ne_of_gt this

  have hq_le : qNat ≤ 108 := by
    have hmul1 : qNat * m ≤ n := by
      simpa [qNat, Nat.mul_comm] using (Nat.mul_div_le n m)
    have hmul2 : qNat * m ≤ 108 * m :=
      le_trans hmul1 (by simpa [m] using hmed)
    exact Nat.le_of_mul_le_mul_right hmul2 hm_pos

  let qFin : Fin 109 := ⟨qNat, Nat.lt_succ_of_le hq_le⟩

  -- Default triangular witness for `q`.
  rcases hdef : cauchyMediumDefault qFin with ⟨b0, t0, u0, v0, w0⟩
  have hdef_spec := cauchyMediumDefault_spec qFin (by simpa [qFin, qNat] using hq_pos)
  -- Unpack the `let`-bound spec using the definitional equality `hdef`.
  have hdef_spec' :
      cauchyTriPredSum4 t0 u0 v0 w0 = qFin.1 ∧
      cauchyBSum4 t0 u0 v0 w0 = b0 ∧
      1 ≤ b0 ∧ b0 ≤ 22 := by
    simpa [hdef] using hdef_spec
  have hQ0 : cauchyTriPredSum4 t0 u0 v0 w0 = qNat := by
    simpa [qFin, qNat] using hdef_spec'.1
  have hB0 : cauchyBSum4 t0 u0 v0 w0 = b0 := by
    simpa using hdef_spec'.2.1
  have hb0_ge1 : 1 ≤ b0 := by
    simpa using hdef_spec'.2.2.1
  have hb0_le22 : b0 ≤ 22 := by
    simpa using hdef_spec'.2.2.2

  have hpoly_def :
      polygonal s t0 + polygonal s u0 + polygonal s v0 + polygonal s w0 = m * qNat + b0 := by
    -- Expand each polygonal term into `t + m*tri(t)`.
    have :
        polygonal s t0 + polygonal s u0 + polygonal s v0 + polygonal s w0
          = (s - 2) * (cauchyTriPredSum4 t0 u0 v0 w0) + (cauchyBSum4 t0 u0 v0 w0) := by
      simp [cauchyBSum4, cauchyTriPredSum4, polygonal_eq_linear,
        Nat.mul_add, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
    -- Rewrite `s-2` as `m` and substitute the table invariants.
    simpa [m, hQ0, hB0, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using this

  by_cases hrem_ge : b0 ≤ remNat
  · -- `Q = q`, `r = rem - b0`.
    let r : ℕ := remNat - b0
    have hr : r ≤ s - 4 := by
      have hrem_lt : remNat < m := Nat.mod_lt n hm_pos
      have : remNat - b0 ≤ m - 2 := by omega
      simpa [m, r] using this
    refine ⟨t0, u0, v0, w0, r, hr, ?_⟩
    have hn_decomp' : m * qNat + remNat = n := hn_decomp
    have hpoly_def_ra :
        polygonal s t0 + (polygonal s u0 + (polygonal s v0 + polygonal s w0)) = m * qNat + b0 := by
      simpa [Nat.add_assoc] using hpoly_def
    calc
      polygonal s t0 + polygonal s u0 + polygonal s v0 + polygonal s w0 + r
          = (polygonal s t0 + (polygonal s u0 + (polygonal s v0 + polygonal s w0))) + r := by
              simp [Nat.add_assoc]
      _ = (m * qNat + b0) + (remNat - b0) := by
              simp [hpoly_def_ra, r, Nat.add_assoc]
      _ = m * qNat + remNat := by
              have hb : b0 + (remNat - b0) = remNat := Nat.add_sub_of_le hrem_ge
              calc
                (m * qNat + b0) + (remNat - b0) = m * qNat + (b0 + (remNat - b0)) := by
                  simp [Nat.add_assoc]
                _ = m * qNat + remNat := by simp [hb]
      _ = n := hn_decomp'
  · -- `rem < b0`, use special table with `rem : Fin 22`.
    have hrem_lt_b0 : remNat < b0 := lt_of_not_ge hrem_ge
    have hrem_lt22 : remNat < 22 := lt_of_lt_of_le hrem_lt_b0 hb0_le22
    let remFin : Fin 22 := ⟨remNat, hrem_lt22⟩

    rcases hsp : cauchyMediumSpecial qFin remFin with ⟨mode, b, t, u, v, w⟩

    -- Avoid unfolding the (large) lookup tables: first rewrite the `let`-bound spec into a function
    -- over `remNat < b0`, then apply it.
    have hspec_fun :=
      cauchyMediumSpecial_spec qFin (by simpa [qFin, qNat] using hq_pos) remFin
    have hspec_fun' :
        remNat < b0 →
          ((mode = false ∧
              cauchyTriPredSum4 t u v w = qNat ∧
              cauchyBSum4 t u v w = b ∧
              1 ≤ b ∧ b ≤ remNat)
            ∨
            (mode = true ∧
              cauchyTriPredSum4 t u v w = qNat - 1 ∧
              cauchyBSum4 t u v w = b ∧
              remNat + 2 ≤ b ∧ b ≤ remNat + 22)) := by
      simpa [hdef, hsp, remFin, qFin, qNat] using hspec_fun
    have hspec' := hspec_fun' hrem_lt_b0

    cases hspec' with
    | inl h0 =>
        -- mode = false: represent `q`, with `b ≤ rem`.
        rcases h0 with ⟨hmode, hQ, hB, hb_ge1, hb_le_rem⟩
        let r : ℕ := remNat - b
        have hr : r ≤ s - 4 := by
          have : remNat - b ≤ m - 2 := by omega
          simpa [m, r] using this
        have hpoly_sum :
            polygonal s t + polygonal s u + polygonal s v + polygonal s w = m * qNat + b := by
          have :
              polygonal s t + polygonal s u + polygonal s v + polygonal s w
                = (s - 2) * (cauchyTriPredSum4 t u v w) + (cauchyBSum4 t u v w) := by
            simp [cauchyBSum4, cauchyTriPredSum4, polygonal_eq_linear,
              Nat.mul_add, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
          -- Convert `Fin` equalities to `Nat` equalities.
          have hQ' : cauchyTriPredSum4 t u v w = qNat := by simpa [qFin, qNat] using hQ
          simpa [m, hQ', hB, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using this
        refine ⟨t, u, v, w, r, hr, ?_⟩
        have hn_decomp' : m * qNat + remNat = n := hn_decomp
        have hpoly_sum_ra :
            polygonal s t + (polygonal s u + (polygonal s v + polygonal s w)) = m * qNat + b := by
          simpa [Nat.add_assoc] using hpoly_sum
        calc
          polygonal s t + polygonal s u + polygonal s v + polygonal s w + r
              = (polygonal s t + (polygonal s u + (polygonal s v + polygonal s w))) + r := by
                  simp [Nat.add_assoc]
          _ = (m * qNat + b) + (remNat - b) := by
                  simp [hpoly_sum_ra, r, Nat.add_assoc]
          _ = m * qNat + remNat := by
                  have hb_le : b ≤ remNat := by simpa [remFin] using hb_le_rem
                  have hb : b + (remNat - b) = remNat := Nat.add_sub_of_le hb_le
                  calc
                    (m * qNat + b) + (remNat - b) = m * qNat + (b + (remNat - b)) := by
                      simp [Nat.add_assoc]
                    _ = m * qNat + remNat := by simp [hb]
          _ = n := hn_decomp'
    | inr h1 =>
        -- mode = true: represent `q-1`, with `rem+2 ≤ b ≤ rem+22`.
        rcases h1 with ⟨hmode, hQ, hB, hb_lo, hb_hi⟩
        let r : ℕ := m + remNat - b
        have hr : r ≤ s - 4 := by
          -- from `rem+2 ≤ b`, we get `m+rem-b ≤ m-2`.
          have hb_lo' : remNat + 2 ≤ b := by simpa [remFin] using hb_lo
          have h1 : m + remNat - b ≤ m + remNat - (remNat + 2) :=
            Nat.sub_le_sub_left hb_lo' (m + remNat)
          have h2 : m + remNat - (remNat + 2) = m - 2 := by
            -- cancel the `remNat` terms.
            -- Use `a+c-(b+c)=a-b` with `a=m`, `b=2`, `c=remNat`, plus commutativity.
            have h : m + remNat - (2 + remNat) = m - 2 := by
              -- `Nat.add_sub_add_right` has the right shape directly.
              simpa using (Nat.add_sub_add_right m remNat 2)
            simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using h
          have : m + remNat - b ≤ m - 2 := by simpa [h2] using h1
          simpa [m, r] using this
        have hpoly_sum :
            polygonal s t + polygonal s u + polygonal s v + polygonal s w = m * (qNat - 1) + b := by
          have :
              polygonal s t + polygonal s u + polygonal s v + polygonal s w
                = (s - 2) * (cauchyTriPredSum4 t u v w) + (cauchyBSum4 t u v w) := by
            simp [cauchyBSum4, cauchyTriPredSum4, polygonal_eq_linear,
              Nat.mul_add, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
          have hQ' : cauchyTriPredSum4 t u v w = qNat - 1 := by simpa [qFin, qNat] using hQ
          simpa [m, hQ', hB, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using this
        refine ⟨t, u, v, w, r, hr, ?_⟩
        have hn_decomp' : m * qNat + remNat = n := hn_decomp
        have hb_total : b ≤ m + remNat := by
          -- `b ≤ rem+22 ≤ rem+m` since `m ≥ 22`.
          have : b ≤ remNat + 22 := by simpa [remFin] using hb_hi
          have hm_ge : 22 ≤ m := by simpa [m] using hm22
          omega
        calc
          polygonal s t + polygonal s u + polygonal s v + polygonal s w + r
              = (polygonal s t + (polygonal s u + (polygonal s v + polygonal s w))) + r := by
                  simp [Nat.add_assoc]
          _ = (m * (qNat - 1) + b) + (m + remNat - b) := by
                  have hpoly_sum_ra :
                      polygonal s t + (polygonal s u + (polygonal s v + polygonal s w))
                        = m * (qNat - 1) + b := by
                    simpa [Nat.add_assoc] using hpoly_sum
                  simp [hpoly_sum_ra, r, Nat.add_assoc]
          _ = m * (qNat - 1) + (m + remNat) := by
                  have hb : b + (m + remNat - b) = m + remNat := Nat.add_sub_of_le hb_total
                  calc
                    (m * (qNat - 1) + b) + (m + remNat - b)
                        = m * (qNat - 1) + (b + (m + remNat - b)) := by
                            simp [Nat.add_assoc]
                    _ = m * (qNat - 1) + (m + remNat) := by simp [hb]
          _ = m * qNat + remNat := by
                  have hmul : m * qNat = m * (qNat - 1) + m := by
                    have hqpos : 0 < qNat := Nat.pos_of_ne_zero hq_pos
                    have hq' : Nat.succ (qNat - 1) = qNat := Nat.succ_pred_eq_of_pos hqpos
                    calc
                      m * qNat = m * Nat.succ (qNat - 1) := by
                        -- Rewrite `qNat` using the predecessor identity.
                        exact congrArg (fun x => m * x) hq'.symm
                      _ = m * (qNat - 1) + m := by
                        simpa using (Nat.mul_succ m (qNat - 1))
                  -- reassociate and use `hmul`
                  calc
                    m * (qNat - 1) + (m + remNat) = (m * (qNat - 1) + m) + remNat := by
                      simp [Nat.add_assoc]
                    _ = m * qNat + remNat := by
                      simp [hmul, Nat.add_assoc]
          _ = n := hn_decomp'

end GeometryOfNumbers