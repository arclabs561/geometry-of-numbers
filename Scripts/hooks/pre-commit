#!/usr/bin/env bash
set -euo pipefail

# Git hook: pre-commit
#
# Goal: run fast, deterministic checks that catch common footguns without rebuilding the world.
# Heavy checks belong in CI or pre-push.

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-commit] gon_checks"
./Scripts/check.sh pre-commit

