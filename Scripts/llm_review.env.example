## LLM pre-commit review (OpenRouter)
#
# Copy this file to `.env` in the repo root (gitignored) or point `COVOLUME_DOTENV_PATH`
# at wherever you keep your key.
#
# Example:
#   cp Scripts/llm_review.env.example .env
#   ./Scripts/check.sh pre-commit

OPENROUTER_API_KEY="..."

# Optional: model selection (OpenRouter model id).
# OPENROUTER_MODEL="openai/gpt-4o-mini"

# Optional: if you want OpenRouter analytics headers.
# OPENROUTER_SITE_URL="https://example.com"
# OPENROUTER_APP_NAME="geometry-of-numbers"

# Optional: disable LLM review in pre-commit.
# GON_LLM_REVIEW=0

# Optional: make LLM misconfig/failure block commits.
# GON_LLM_REVIEW_STRICT=1

